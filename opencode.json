{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deeprelay": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepRelay",
      "options": {
        "baseURL": "https://api.deeprelay.ai/v1",
        "apiKey": "{env:DEEPRELAY_API_KEY}"
      },
      "models": {
        "deeprelay/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash (plan baseline)",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 1048576, "output": 65536 }
        },
        "deeprelay/glm-5.3-flash": {
          "name": "GLM 5.3 Flash (1.75x credits)",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 1048576, "output": 65536 }
        }
      }
    }
  },
  "model": "deeprelay/deeprelay/deepseek-v4.1-flash",
  "small_model": "deeprelay/deeprelay/deepseek-v4.1-flash"
}
