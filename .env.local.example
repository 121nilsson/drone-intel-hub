# Local overrides. Copy to .env.local and fill in. docker-compose.yml loads this file into
# the app container too (env_file), so the same settings apply to `npm run dev` and Docker.
# Anything set here overrides the matching value saved in the browser's Settings page.
#
# Never prefix a secret with VITE_: Vite exposes VITE_* variables to the browser bundle.

# --- AI providers -------------------------------------------------------------------------
# Any OpenAI-compatible provider with a key takes part. They are tried in priority order
# (deeprelay, nvidia, groq, openrouter, mistral); a provider that is rate-limited, out of credits,
# rejecting its key or down is skipped and the next one answers. With no key at all the
# app runs the built-in heuristic engine. Keys stay on the server.
DEEPRELAY_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Optional per-provider overrides, for NAME in DEEPRELAY, NVIDIA, GROQ, OPENROUTER, MISTRAL:
#   ${NAME}_BASE_URL           any OpenAI-compatible base URL (https only)
#   ${NAME}_TIER1_MODEL        fast screening model on that provider
#   ${NAME}_TIER2_MODEL        deep model on that provider (escalation and the briefing)
#   ${NAME}_TRANSLATE_MODEL    translation model (NVIDIA defaults to riva-translate)
#   ${NAME}_RPM                requests/min for that provider, overriding PROVIDER_RPM
# Model ids belong to one provider's catalogue: set each provider's own ids, never another's.
# NVIDIA_TIER1_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_TIER2_MODEL=nvidia/nemotron-3-super-120b-a12b
# Groq limits are per model, so different tier models get separate daily budgets.
# GROQ_TIER1_MODEL=qwen/qwen3.8-27b
# GROQ_TIER2_MODEL=openai/gpt-oss-120b
# DeepRelay: deepseek-v4.1-flash is the plan baseline and the default for both tiers.
# glm-5.3-flash is the only alternative to consider; it costs 1.75x the token credits.
# DEEPRELAY_TIER2_MODEL=deeprelay/glm-5.3-flash

# Requests per minute each provider is paced to. Applies across all callers (cron, manual
# sync, browser), since a provider counts per API key. Defaults to 35, under NVIDIA's 40 RPM
# free tier. Set 0 to disable pacing for a self-hosted endpoint.
PROVIDER_RPM=35

# Per-request timeout in ms, so a hung provider connection cannot stall a sync pass. Generous:
# this bounds a hang, it does not police latency. Set 0 to disable.
PROVIDER_TIMEOUT_MS=90000
