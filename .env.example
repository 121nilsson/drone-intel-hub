# Copy to .env and fill in. Never commit the real .env - it holds secrets.
# Docker Compose interpolates docker-compose.yml from this file and loads it into the app
# container; .env.local (see .env.local.example) is loaded after it and wins.

# Set this to make the server use PostgreSQL instead of browser localStorage.
# Host-side port, as published by docker-compose.yml; the container uses 5432.
# (Inside Docker, compose sets its own DATABASE_URL pointing at the db service.)
DATABASE_URL=postgres://droneint:droneint@127.0.0.1:5435/droneint

# Optional: AI provider keys. See .env.local.example for the full documented set.
# A key here overrides one saved in the browser's Settings page.
DEEPRELAY_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=

# Requests/min each provider is paced to. 0 disables pacing.
PROVIDER_RPM=35

# Per-item ingestion tracing, printed as `[pipeline] ...` to the server console.
#   (unset)  one line per item: position, source, engines, what was found, what was written
#   verbose  the above plus the post excerpt
#   0        off
PIPELINE_TRACE=
